# Postgres (Neon in production: the Vercel Marketplace integration injects both)
DATABASE_URL=postgres://you@localhost:5432/okara_tweet
DATABASE_URL_UNPOOLED=

# Better Auth: secret = `openssl rand -base64 48`; URL = where the app runs
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3333

# OAuth sign-in, each optional (email + password always works). Callbacks: <BETTER_AUTH_URL>/api/auth/callback/<google|github>.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Server-side only. Never prefix these with NEXT_PUBLIC_.
OPENAI_API_KEY=
X_BEARER_TOKEN=

# Optional: Langfuse tracing of every LLM call. On only when the first three are set.
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# LANGFUSE_TRACING_ENVIRONMENT=dev

# Local dev only: caches raw X API responses on disk so re-runs don't spend credits. Leave unset on Vercel.
X_RAW_CACHE_DIR=.data/x

# Handles fetched by `pnpm seed:demo`
DEMO_HANDLES=levelsio,paulg,naval
